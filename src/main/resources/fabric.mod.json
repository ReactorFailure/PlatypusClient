{
	"schemaVersion": 1,
	"id": "platypusclient",
	"version": "${version}",
	"name": "PlatypusClient",
	"description": "A terribly made Fabric client mod",
	"authors": [
		"ReactorFailure"
	],
	"contact": {
		"homepage": "https://github.com/ReactorFailure/PlatypusClient/wiki",
		"sources": "https://github.com/ReactorFailure/PlatypusClient"
	},
	"license": "LGPL-3.0",
	"icon": "assets/platypusclient/icon.png",
	"environment": "*",
	"entrypoints": {
